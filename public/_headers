# l-helper — Cloudflare Pages headers

# Hashed Vite assets (JS/CSS) are content-addressed, so cache them aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline security headers for every route.
# Note: `connect-src 'self' https:` allows the app to reach user-configured
# LLM endpoints (OpenAI, Google Gemini, or custom HTTPS proxies) while blocking
# insecure HTTP origins.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
